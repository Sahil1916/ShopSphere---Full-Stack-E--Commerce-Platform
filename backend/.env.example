DB_HOST=your-aiven-host
DB_PORT=your-aiven-port
DB_NAME=your-aiven-database
DB_USERNAME=your-aiven-username
DB_PASSWORD=your-aiven-password
DB_SSL_MODE=REQUIRED
JPA_DDL_AUTO=update

# Your Netlify site URL. Example: https://shop-with-sahil.netlify.app
FRONTEND_URLS=https://your-site.netlify.app
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=None
APP_URL=https://your-site.netlify.app

# Optional: email notifications
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=shopverse.notifications@gmail.com
MAIL_SUPPORT=support@shopverse.com
